# All model names live here and only here. Swap freely.
# OpenAI-compatible endpoint used by every service (Ollama serves /v1).
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=local-not-a-secret
# Host-side URL used by the agent harness and aliases
HOST_OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Cloud/CPU placeholder (US/EU origin, tiny). On the GPU box use gpt-oss:20b.
MODEL_NAME=gemma3:1b
# GPU box: devstral:24b
MODEL_CODE=gemma3:1b
# GPU box: gemma3:27b or mistral-small3.2:24b
MODEL_WRITE=gemma3:1b
# GPU box: gpt-oss:120b
MODEL_THINK=gemma3:1b
EMBED_MODEL=nomic-embed-text

# Ports (bound to 127.0.0.1 only)
OLLAMA_PORT=11434
WEBUI_PORT=3000
SEARXNG_PORT=8080
CHROMA_PORT=8000

# Ollama tuning (CPU defaults; the GPU overlay raises context)
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_CONTEXT_LENGTH_GPU=32768
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# SearXNG secret: generate with `openssl rand -hex 32`
SEARXNG_SECRET=change-me-generate-with-openssl-rand-hex-32

# Telemetry off
DO_NOT_TRACK=true
